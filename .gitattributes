# ============================================================
# 换行符规则 —— 本仓库的文件要直接放到 Linux 上运行, 统一 LF
# .gitattributes 优先级高于 core.autocrlf, 跟着仓库走
# ============================================================

# shell 脚本一律 LF
*.sh     text eol=lf
*.bash   text eol=lf
*.zsh    text eol=lf
vimrc    text eol=lf
.vimrc   text eol=lf
*.vim    text eol=lf

# 其它常见脚本/配置也固定 LF
*.py     text eol=lf
*.pl     text eol=lf
*.conf   text eol=lf
*.service text eol=lf
*.timer  text eol=lf
*.mount  text eol=lf
Makefile text eol=lf

# 二进制文件, 严禁任何转换
*.tar.gz binary
*.tgz    binary
*.zip    binary
*.gz     binary
*.xz     binary
*.deb    binary
*.rpm    binary
*.vhdx   binary
*.exe    binary
